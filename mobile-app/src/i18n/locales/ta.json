    "s118": "மீண்டும் முயலவும்.",
    "s119": "பணியின் பெயரை உள்ளிடவும்.",
    "s120": "பழக்கத்தின் பெயரை உள்ளிடவும்.",
    "s121": "உங்கள் தினசரி பழக்கம்",
    "s122": "இன்று அல்லது எதிர்கால தேதியைத் தேர்ந்தெடுக்கவும்.",
    "s123": "எதிர்கால நேரத்தைத் தேர்ந்தெடுக்கவும்.",
    "s124": "பணி சேமிக்கப்பட்டது",
    "s125": "பணியை நீக்கவா?",
    "s126": "இந்தப் பணியை நீக்கவா?",
    "s127": "பழக்கத்தை நீக்கவா?",
    "s128": "இதன் நிறைவு வரலாறும் நீக்கப்படும்.",
    "s129": "நகல்களை நீக்கவா?",
    "s130": "நீக்கு",
    "s131": "பதிவுகளை ஏற்ற முடியவில்லை. மீண்டும் முயலவும்.",
    "s132": "பணிகளைப் புதுப்பிக்க முடியவில்லை.",
    "s133": "இந்த தேதி மற்றும் நேரத்தில் பணி ஏற்கனவே உள்ளது.",
    "s134": "பணியைச் சேமிக்க முடியவில்லை",
    "s135": "இந்தச் சாதனத்தில் பழக்கங்களைச் சேமிக்க முடியவில்லை.",
    "s136": "YYYY-MM-DD வடிவில் தேதியை உள்ளிடவும்.",
    "s137": "சரியான தேதியை உள்ளிடவும்.",
    "s138": "சரியான நேரத்தை உள்ளிடவும், எ.கா. 06:30 PM.",
    "s139": "வெளியேற முடியவில்லை. மீண்டும் முயலவும்.",
    "s140": "பணிகளை ஏற்ற முடியவில்லை. திரையை மீண்டும் திறக்கவும்.",
    "s141": "மாற்றங்களைச் சேமிக்க முடியவில்லை",
    "s142": "ஒரே பணியின் ஒரு நகலை வைத்திருங்கள்; முடித்த நகலுக்கு முன்னுரிமை.",
    "s143": "இணைய இணைப்பைச் சரிபார்த்து மீண்டும் முயலவும்.",
    "s144": "அதிக முயற்சிகள். பின்னர் மீண்டும் முயலவும்.",
    "s145": "சுயவிவரத்தைச் சேமிக்க முடியவில்லை. மீண்டும் முயலவும்."
  },
  "manageFeatures": {
    "dataSafety": "ஒரு அம்சத்தை முடக்கினால் அது மறைக்கப்படும். சேமித்த தரவு நீக்கப்படாது."
  }
}
